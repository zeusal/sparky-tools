root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{md,yml,yaml,json,html,css,js,mjs}]
indent_size = 2

[*.md]
trim_trailing_whitespace = false

# Test files and expected outputs are compared byte for byte (CRLF, UTF-16, BOM).
[tools/*/tests/{fixtures,expected}/**]
charset = unset
end_of_line = unset
insert_final_newline = unset
trim_trailing_whitespace = unset
